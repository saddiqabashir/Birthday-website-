* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #fff5f8;
    color: #4a2734;
    overflow-x: hidden;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;

    background:
        radial-gradient(circle at top, rgba(255,255,255,.5), transparent 40%),
        linear-gradient(135deg, #ffd6e5, #fff1f6, #ffdbe8);

    padding: 30px;
    position: relative;
}


.hero-content {
    max-width: 750px;
    animation: fadeUp 1.5s ease;
}


.small-text {
    font-size: 14px;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 25px;
    opacity: .7;
}


.hero h1 {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(55px, 12vw, 110px);
    font-weight: 400;
    line-height: 1;
    color: #a42b59;
}


.hero h1 span {
    display: block;
    color: #7c2346;
}


.intro {
    margin: 35px auto;
    line-height: 1.9;
    font-size: 16px;
    max-width: 550px;
}


/* =========================
   BUTTON
========================= */

.main-button {
    border: none;
    padding: 16px 30px;
    border-radius: 50px;

    background: #a42b59;
    color: white;

    font-family: inherit;
    font-size: 15px;
    font-weight: 600;

    cursor: pointer;

    box-shadow: 0 12px 30px rgba(164,43,89,.25);

    transition: .3s;
}


.main-button:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 35px rgba(164,43,89,.35);
}


.main-button:active {
    transform: scale(.96);
}


/* =========================
   SECTIONS
========================= */

.section {
    padding: 100px 20px;
    max-width: 1000px;
    margin: auto;
    text-align: center;
}


.section-label {
    color: #b13b67;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 15px;
}


.section h2 {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(48px, 9vw, 75px);
    font-weight: 400;
    color: #8d274f;
    margin-bottom: 30px;
}


.section h2 span {
    display: block;
}


.section-description {
    max-width: 600px;
    margin: auto;
    line-height: 1.8;
}


/* =========================
   BIRTHDAY MESSAGE
========================= */

.birthday-message {
    padding-top: 130px;
}


.birthday-message p {
    max-width: 650px;
    margin: 20px auto;
    line-height: 1.9;
}


.highlight {
    font-weight: 600;
    color: #a42b59;
    font-size: 18px;
}


/* =========================
   COUNTDOWN
========================= */

.countdown-section {
    max-width: 900px;
}


.countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-top: 40px;
}


.time-box {
    background: rgba(255,255,255,.75);
    border-radius: 20px;
    padding: 25px 10px;

    box-shadow: 0 10px 30px rgba(100,30,60,.08);

    backdrop-filter: blur(10px);
}


.time-box span {
    display: block;
    font-size: 36px;
    font-weight: 700;
    color: #a42b59;
}


.time-box small {
    color: #7b5261;
}


/* =========================
   LOVE LETTER
========================= */

.letter-section {
    max-width: 850px;
}


.letter {
    background: rgba(255,255,255,.85);
    border-radius: 25px;
    padding: 45px 30px;

    text-align: left;

    box-shadow: 0 20px 50px rgba(80,20,50,.08);

    line-height: 1.9;
}


.letter p {
    margin-bottom: 20px;
}


.love-line {
    color: #a42b59;
    font-weight: 600;
    font-size: 18px;
}


.signature {
    font-family: 'Great Vibes', cursive;
    font-size: 32px;
    text-align: right;
}


/* =========================
   GALLERY
========================= */

.gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 45px;
}


.photo-card {
    background: white;
    padding: 10px;
    border-radius: 20px;

    box-shadow: 0 15px 35px rgba(80,20,50,.1);

    transition: .4s;
}


.photo-card:hover {
    transform: translateY(-8px) rotate(1deg);
}


.photo-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 14px;
}


.photo-card p {
    padding: 14px 5px;
    font-size: 14px;
}


/* =========================
   TIMELINE
========================= */

.timeline {
    max-width: 700px;
    margin: 50px auto;
    text-align: left;
}


.timeline-item {
    display: flex;
    gap: 20px;
    margin-bottom: 35px;
}


.timeline-dot {
    min-width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #ffd4e3;

    font-size: 23px;
}


.timeline-content {
    background: white;
    padding: 20px;
    border-radius: 15px;

    flex: 1;

    box-shadow: 0 10px 25px rgba(80,20,50,.07);
}


.timeline-content h3 {
    color: #9c2c57;
    margin-bottom: 8px;
}


/* =========================
   REASONS
========================= */

.reasons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}


.reason {
    background: white;
    border-radius: 20px;
    padding: 30px 20px;

    box-shadow: 0 10px 30px rgba(80,20,50,.07);
}


.reason span {
    font-size: 40px;
}


.reason h3 {
    margin: 15px 0 10px;
    color: #9c2c57;
}


.reason p {
    font-size: 14px;
    line-height: 1.7;
}


/* =========================
   SURPRISE
========================= */

.surprise-section {
    max-width: 850px;
}


.surprise-box {
    background:
        linear-gradient(135deg, #ffd5e3, #fff1f6);

    border-radius: 30px;
    padding: 70px 25px;

    box-shadow: 0 20px 60px rgba(100,30,60,.1);
}


.surprise-message {
    display: none;
    margin-top: 35px;

    animation: zoomIn .7s ease;
}


.surprise-message h3 {
    font-family: 'Great Vibes', cursive;
    font-size: 55px;
    color: #a42b59;
    margin-bottom: 15px;
}


.surprise-message p {
    line-height: 1.8;
    margin-bottom: 10px;
}


/* =========================
   FINAL SECTION
========================= */

.final-section {
    min-height: 80vh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 80px 25px;

    background:
        linear-gradient(
            135deg,
            #7c2346,
            #a42b59,
            #d95d86
        );

    color: white;
}


.final-content {
    max-width: 650px;
}


.big-heart {
    font-size: 80px;
    animation: heartbeat 1.3s infinite;
}


.final-section h2 {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(55px, 12vw, 90px);
    font-weight: 400;
    margin: 20px 0;
}


.final-section p {
    line-height: 1.8;
}


.forever {
    font-family: 'Great Vibes', cursive;
    font-size: 35px;
    margin-top: 30px;
}


/* =========================
   MUSIC BUTTON
========================= */

.music-button {
    position: fixed;

    right: 20px;
    bottom: 20px;

    width: 52px;
    height: 52px;

    border: none;
    border-radius: 50%;

    background: #a42b59;
    color: white;

    font-size: 22px;

    cursor: pointer;

    box-shadow: 0 10px 25px rgba(0,0,0,.2);

    z-index: 1000;
}


/* =========================
   FLOATING HEARTS
========================= */

.heart {
    position: fixed;

    bottom: -30px;

    font-size: 20px;

    pointer-events: none;

    animation: floatHeart linear forwards;

    z-index: 999;
}


/* =========================
   UTILITIES
========================= */

.hidden {
    display: none;
}


/* =========================
   ANIMATIONS
========================= */

@keyframes fadeUp {

    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


@keyframes zoomIn {

    from {
        opacity: 0;
        transform: scale(.7);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}


@keyframes heartbeat {

    0%, 100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.2);
    }
}


@keyframes floatHeart {

    from {
        transform: translateY(0) rotate(0);
        opacity: 1;
    }

    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

    .hero {
        min-height: 100svh;
        padding: 25px;
    }

    .small-text {
        font-size: 10px;
        letter-spacing: 2px;
    }

    .intro {
        font-size: 14px;
    }

    .section {
        padding: 75px 18px;
    }

    .countdown {
        grid-template-columns: repeat(2, 1fr);
    }

    .gallery {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .photo-card {
        padding: 7px;
    }

    .photo-card p {
        font-size: 11px;
    }

    .reasons {
        grid-template-columns: 1fr;
    }

    .letter {
        padding: 30px 20px;
        font-size: 14px;
    }

    .timeline-item {
        gap: 12px;
    }

    .timeline-dot {
        min-width: 45px;
        height: 45px;
        font-size: 18px;
    }

    .timeline-content {
        font-size: 13px;
    }

}
